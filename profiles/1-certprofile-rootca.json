{
  "version": "v3",
  "metadata": {
    "category": "根证书模板",
    "details": "certprofile rootca"
  },
  "certLevel": "SubCA",
  "validity": "8y",
  "notBeforeTime": "current",
  "signatureAlgorithms": ["SHA512WITHRSA","SHA384WITHRSA","SHA256WITHRSA","SM3WITHSM2"],
  "keyAlgorithms": ["RSA-2048","RSA-4096","SM2P256V1"],
  "subject": [{
      "type": "country"
    },{
      "type": "organization"
    },{
      "type": "organizationalUnit",
      "minOccurs": 0
    },{
      "type": "commonName"
    }
  ],
  "extensions": [{
      "type": "SubjectKeyIdentifier",
      "required": true
    },{
      "type": "BasicConstraints",
      "required": true,
      "critical": true
    },{
      "type": "KeyUsage",
      "required": true,
      "critical": true,
      "inRequest": "optional",
      "keyUsage": {
        "usages": [{
            "required": ["keyCertSign","cRLSign"]
          }
        ]
      }
    }
  ]
}