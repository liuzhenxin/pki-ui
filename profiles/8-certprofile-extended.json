{
  "metadata": {
    "category": "证书自定义扩展证书模板",
    "details": "certprofile extended"
  },
  "certLevel": "EndEntity",
  "maxSize": 8400,
  "validity": "5y",
  "notBeforeTime": "current",
  "signatureAlgorithms": ["SHA512WITHRSA","SHA384WITHRSA","SHA256WITHRSA","SM3WITHSM2"],
  "keyAlgorithms": ["RSA-2048","RSA-4096","SM2P256V1"],
  "subject": [{
      "type": "country"
    },{
      "type": "organization"
    },{
      "type": "organizationalUnit",
      "minOccurs": 0
    },{
      "type": "serialNumber",
      "minOccurs": 0
    },{
      "type": "commonName",
      "toSAN": "DNSName",
      "regex": ":FQDN"
    }
  ],
  "extensions": [{
      "type": "SubjectKeyIdentifier",
      "required": true
    },{
      "type": "CRLDistributionPoints"
    },{
      "type": "FreshestCRL"
    },{
      "type": "SubjectAlternativeName",
      "required": true,
      "inRequest": "required",
      "subjectAltName": {
        "modes": ["IPAddress","DNSName"]
      }
    },{
      "type": "BasicConstraints",
      "required": true,
      "critical": true
    },{
      "type": "AuthorityInfoAccess",
      "required": true,
      "authorityInfoAccess": {
        "includeCaIssuers": true,
        "includeOcsp": true
      }
    },{
      "type": "AuthorityKeyIdentifier",
      "required": true
    },{
      "type": "KeyUsage",
      "required": true,
      "critical": true,
      "inRequest": "optional",
      "keyUsage": {
        "usages": [{
            "required": ["digitalSignature","keyEncipherment","dataEncipherment"]
          }
        ]
      }
    },{
      "type": "ExtendedKeyUsage",
      "required": true,
      "inRequest": "optional",
      "extendedKeyUsage": {
        "required": ["serverAuth"],
        "optional": ["clientAuth"]
      }
    },{
      "type": "TLSFeature",
      "required": true,
      "critical": true,
      "tlsFeature": {
        "features": [2,5]
      }
    },{
      "type": "SMIMECapabilities",
      "required": true,
      "smimeCapabilities": {
        "capabilities": [{
            "capabilityId": {
              "oid": "1.2.840.113549.3.7",
              "description": "DES-EDE3-CBC"
            }
          },{
            "capabilityId": {
              "oid": "1.2.840.113549.3.2",
              "description": "RC2-CBC"
            },
            "parameter": {
              "integer": 128
            }
          },{
            "capabilityId": {
              "oid": "1.2.840.113549.3.2",
              "description": "RC2-CBC"
            },
            "parameter": {
              "integer": 64
            }
          }
        ]
      }
    },{
      "type": "1.2.3.4.1",
      "required": true,
      "inRequest": "required"
    }
  ]
}