{
  "version": "v3",
  "metadata": {
    "category": "安全Internet邮件证书模板",
    "details": "certprofile s/mime"
  },
  "certLevel": "EndEntity",
  "validity": "5y",
  "notBeforeTime": "midnight",
  "signatureAlgorithms": ["SHA512WITHRSA","SHA384WITHRSA","SHA256WITHRSA","SM3WITHSM2"],
  "keyAlgorithms": ["RSA-2048","RSA-4096","SM2P256V1"],
  "subject": [{
      "type": "country"
    },{
      "type": "organization"
    },{
      "type": "organizationalUnit",
      "minOccurs": 0
    },{
      "type": "serialNumber",
      "minOccurs": 0
    },{
      "type": "commonName"
    },{
      "type": "emailAddress",
      "minOccurs": 0,
      "maxOccurs": 0,
      "toSAN": "rfc822Name"
    }
  ],
  "extensions": [{
      "type": "SubjectKeyIdentifier",
      "required": true
    },{
      "type": "CRLDistributionPoints"
    },{
      "type": "FreshestCRL"
    },{
      "type": "SubjectAlternativeName",
      "required": true,
      "inRequest": "optional",
      "subjectAltName": {
        "modes": ["rfc822Name"]
      }
    },{
      "type": "BasicConstraints",
      "required": true,
      "critical": true
    },{
      "type": "AuthorityInfoAccess",
      "required": true,
      "authorityInfoAccess": {
        "includeCaIssuers": true,
        "includeOcsp": true
      }
    },{
      "type": "AuthorityKeyIdentifier",
      "required": true
    },{
      "type": "KeyUsage",
      "required": true,
      "critical": true,
      "inRequest": "optional",
      "keyUsage": {
        "usages": [{
            "required": ["digitalSignature","keyEncipherment","dataEncipherment"]
          }
        ]
      }
    },{
      "type": "ExtendedKeyUsage",
      "required": true,
      "inRequest": "optional",
      "extendedKeyUsage": {
        "required": ["emailProtection"]
      }
    },{
      "type": "SMIMECapabilities",
      "required": true,
      "smimeCapabilities": {
        "capabilities": [{
            "capabilityId": {
              "oid": "1.2.840.113549.3.7",
              "description": "DES-EDE3-CBC"
            }
          },{
            "capabilityId": {
              "oid": "1.2.840.113549.3.2",
              "description": "RC2-CBC"
            },
            "parameter": {
              "integer": 128
            }
          },{
            "capabilityId": {
              "oid": "1.2.840.113549.3.2",
              "description": "RC2-CBC"
            },
            "parameter": {
              "integer": 64
            }
          }
        ]
      }
    }
  ]
}