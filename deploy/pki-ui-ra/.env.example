# Docker network containing pki-gateway and pki-ra.
DOCKER_NETWORK=pki-cluster

# Host port for the RA UI. The current 128 deployment uses 9083.
UI_PORT=9083

# Service name and internal port on the Docker network.
GATEWAY_HOST=pki-gateway
GATEWAY_PORT=5555

# Build target and server configuration used by the root compose file.
BUILD_TARGET=ra
NGINX_CONF=deploy/pki-ui-ra/nginx.conf
