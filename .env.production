# 页面标题
VITE_APP_TITLE =
VITE_APP_LOGO_TITLE =
# 租户Id
# 租户Code
# 生产环境配置
VITE_APP_ENV = 'production'

# 应用访问路径 例如使用前缀 /admin/
VITE_APP_CONTEXT_PATH = '/'

# 监控地址
VITE_APP_MONITOR_ADMIN = '/admin/applications'

# SnailJob 控制台地址
VITE_APP_SNAILJOB_ADMIN = '/snail-job'

# 生产环境
VITE_APP_BASE_API = '/api-gateway'

# liuzx-ops 通过网关的 ops 路由转发
VITE_APP_OPS_API = '/api-gateway/ops'

# 是否在打包时开启压缩，支持 gzip 和 brotli
VITE_BUILD_COMPRESS = gzip

VITE_APP_PORT = 80

# 系统版本
VITE_APP_VERSION = '3.5.5'

# 接口加密功能开关(如需关闭 后端也必须对应关闭)
VITE_APP_ENCRYPT = false
# 接口加密传输 RSA 公钥与后端解密私钥对应 如更换需前后端一同更换
VITE_APP_RSA_PUBLIC_KEY = ''
# 接口响应解密 RSA 私钥与后端加密公钥对应 如更换需前后端一同更换
VITE_APP_RSA_PRIVATE_KEY = ''

# 客户端id
VITE_APP_CLIENT_ID = 'e5cd7e4891bf95d1d19206ce24a7b32e'
# 证书挑战与Token兑换必须使用同一个、已启用certificate-signature grant的OAuth2客户端
VITE_APP_CERTIFICATE_CLIENT_ID = '95TxSsTPFA3tF12TBSMmUVK0da'
# HTTPS页面部署时，本机SKF服务必须提供WSS，并将此项改为wss://127.0.0.1:9001
VITE_APP_SKF_WS_URL = 'ws://127.0.0.1:9001'

# 本 UI 部署服务的租户 ID（逗号分隔；空 = 全部 PKI 租户）
# OPS UI 填 1，CA UI 填 4（并在构建时替换 VITE_APP_CLIENT_ID 为对应 client）
VITE_APP_TENANT_IDS = ''

# websocket 开关 默认使用sse推送
VITE_APP_WEBSOCKET = false

# sse 开关
VITE_APP_SSE = false
